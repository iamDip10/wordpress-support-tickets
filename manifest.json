{
  "manifest_version": 3,
  "name": "WP Support Monitor",
  "version": "2.0",
  "description": "Realtime WordPress.org support monitor",
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://wordpress.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/bell.png"
  }
}